# Frontend Firebase configuration (public Firebase app configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only Vercel Function configuration. NEVER prefix these with VITE_.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Firebase Admin: preferred format is the complete service-account JSON.
# Keep this value only in Vercel/server environment variables; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Admin legacy split format (used when FIREBASE_SERVICE_ACCOUNT_JSON is absent).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web API key used server-side to validate the Firebase ID token.
# This is the same public key used by VITE_FIREBASE_API_KEY.
FIREBASE_WEB_API_KEY=

ALLOWED_ORIGINS=http://localhost:5173

# CORS origins allowed for the /api/upload endpoint.
# In Vercel, set this to your production origin, e.g. https://your-app.vercel.app
