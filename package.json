{
    "name":  "e-commerce",
    "version":  "0.1.0",
    "private":  true,
    "description":  "E-Commerce — Proyecto Integrador 5",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc --noEmit -p tsconfig.app.json \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "lint":  "eslint . --max-warnings=0",
                    "lint:fix":  "eslint . --fix --max-warnings=0",
                    "format":  "prettier --write .",
                    "format:check":  "prettier --check .",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:coverage":  "vitest run --coverage",
                    "test:rules":  "RUN_RULES_TESTS=true vitest run tests/unit/security",
                    "typecheck:api":  "tsc --noEmit -p tsconfig.api.json",
                    "seed":  "tsx scripts/seed.ts",
                    "migrate:categories":  "tsx scripts/migrateProductCategories.ts",
                    "fix:product-images":  "tsx scripts/fix-product-images.ts",
                    "fix:replace-picsum":  "tsx scripts/replace-picsum-images.ts"
                },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "^3.1112.0",
                         "@aws-sdk/s3-request-presigner":  "^3.1112.0",
                         "firebase":  "^12.17.1",
                         "firebase-admin":  "^14.2.0",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "react-router-dom":  "^6.29.0",
                         "uuid":  "^14.0.1"
                     },
    "devDependencies":  {
                            "@firebase/rules-unit-testing":  "^5.0.1",
                            "@testing-library/dom":  "^10.4.0",
                            "@testing-library/jest-dom":  "^6.6.0",
                            "@testing-library/react":  "^14.3.1",
                            "@testing-library/user-event":  "^14.5.2",
                            "@types/node":  "^26.2.0",
                            "@types/react":  "^18.3.14",
                            "@types/react-dom":  "^18.3.0",
                            "@vercel/node":  "^5.10.1",
                            "@vitejs/plugin-react-swc":  "^4.3.0",
                            "autoprefixer":  "^10.4.16",
                            "dotenv":  "^17.4.2",
                            "eslint":  "^9.18.0",
                            "eslint-config-prettier":  "^9.1.0",
                            "eslint-plugin-react-hooks":  "^5.1.0",
                            "globals":  "^15.14.0",
                            "jsdom":  "^25.0.0",
                            "prettier":  "^3.4.2",
                            "tailwindcss":  "^3.4.1",
                            "tsx":  "^4.23.12",
                            "typescript":  "^5.7.3",
                            "typescript-eslint":  "^8.0.0",
                            "vite":  "^5.4.1",
                            "vitest":  "^2.1.9"
                        }
}
