rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return getUserRole() == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOrderOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function pricesValid() {
      return request.resource.data.subtotalCents is int
        && request.resource.data.subtotalCents >= 0
        && request.resource.data.taxCents is int
        && request.resource.data.taxCents >= 0
        && request.resource.data.shippingCents is int
        && request.resource.data.shippingCents >= 0
        && request.resource.data.discountCents is int
        && request.resource.data.discountCents >= 0
        && request.resource.data.totalCents is int
        && request.resource.data.totalCents >= 0;
    }

    // Direct client order creation is intentionally disabled.
    // Checkout is created by /api/checkout using Firebase Admin SDK, where
    // prices and stock are read from trusted product documents and stock is
    // decremented atomically in the same transaction as the order.
    // This prevents price tampering and partial order/stock writes.

    function orderAllowedFields() {
      return request.resource.data.keys().hasOnly([
        'id', 'userId', 'items', 'subtotalCents', 'taxCents',
        'shippingCents', 'discountCents', 'totalCents', 'currency',
        'status', 'statusHistory', 'createdAt', 'updatedAt',
        'notes', 'shippingAddress', 'billingAddress', 'paymentMethod',
      ]);
    }

    function orderCustomerUpdatableFields() {
      return request.resource.data.keys().hasOnly([
        'id', 'userId', 'items', 'subtotalCents', 'taxCents',
        'shippingCents', 'discountCents', 'totalCents', 'currency',
        'status', 'statusHistory', 'createdAt', 'updatedAt',
        'notes', 'shippingAddress', 'billingAddress', 'paymentMethod',
      ])
      && request.resource.data.userId == resource.data.userId
      && request.resource.data.status == resource.data.status
      && request.resource.data.items == resource.data.items
      && request.resource.data.subtotalCents == resource.data.subtotalCents
      && request.resource.data.taxCents == resource.data.taxCents
      && request.resource.data.shippingCents == resource.data.shippingCents
      && request.resource.data.discountCents == resource.data.discountCents
      && request.resource.data.totalCents == resource.data.totalCents
      && request.resource.data.currency == resource.data.currency
      && request.resource.data.statusHistory == resource.data.statusHistory
      && request.resource.data.shippingAddress == resource.data.shippingAddress
      && request.resource.data.billingAddress == resource.data.billingAddress
      && request.resource.data.createdAt == resource.data.createdAt;
    }

    function userAllowedFields() {
      return request.resource.data.keys().hasOnly([
        'uid', 'email', 'displayName', 'photoURL',
        'role', 'createdAt', 'lastLoginAt', 'preferences',
      ]);
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && !exists(/databases/$(database)/documents/users/$(uid))
        && userAllowedFields()
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer';

      allow update: if (isAdmin()
        && userAllowedFields()
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt)
        || (isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoURL',
          'lastLoginAt', 'preferences',
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt);

      allow delete: if false;
    }

    match /products/{productId} {
      allow list, get: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || isOrderOwner();
      allow list: if isAdmin() || isOrderOwner();

      // Never allow the browser to create an order. The trusted API endpoint
      // performs the complete checkout transaction with Admin SDK.
      allow create: if false;

      allow update: if (isAdmin() && orderAllowedFields())
        || (isOrderOwner() && orderCustomerUpdatableFields());

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
