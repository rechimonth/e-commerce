rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAdmin() { return getUserRole() == 'admin'; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isOrderOwner() { return isSignedIn() && resource.data.userId == request.auth.uid; }
    function validProduct(data) {
      return data.keys().hasOnly([
          'id', 'name', 'nameLower', 'description', 'priceCents', 'currency', 'category', 'imageKey', 'imageUrl',
          'images', 'stock', 'rating', 'reviewCount', 'isActive', 'createdAt', 'updatedAt', 'createdBy',
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.description is string && data.description.size() <= 5000
        && data.priceCents is int && data.priceCents >= 0 && data.priceCents <= 100000000
        && data.currency in ['USD', 'MXN', 'EUR', 'GBP', 'CAD']
        && data.category in ['action-figures', 'video-games', 'shoes']
        && data.imageKey is string && data.imageKey.size() <= 2048
        && data.imageUrl is string && data.imageUrl.size() <= 4096
        && (!('nameLower' in data.keys()) || (data.nameLower is string && data.nameLower.size() <= 160))
        && (!('images' in data.keys()) || (data.images is list && data.images.size() <= 10))
        && data.stock is int && data.stock >= 0 && data.stock <= 1000000
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && data.reviewCount is int && data.reviewCount >= 0
        && data.isActive is bool
        && data.createdBy is string && data.createdBy.size() > 0
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function orderCoreUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.items == resource.data.items
        && request.resource.data.subtotalCents == resource.data.subtotalCents
        && request.resource.data.taxCents == resource.data.taxCents
        && request.resource.data.shippingCents == resource.data.shippingCents
        && request.resource.data.discountCents == resource.data.discountCents
        && request.resource.data.totalCents == resource.data.totalCents
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.shippingAddress == resource.data.shippingAddress
        && request.resource.data.billingAddress == resource.data.billingAddress
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    function adminOrderUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'trackingNumber', 'carrier', 'estimatedDelivery', 'attachments', 'updatedAt',
        ])
        && orderCoreUnchanged()
        && request.resource.data.updatedAt == request.time
        && (!('trackingNumber' in request.resource.data.keys()) || request.resource.data.trackingNumber is string)
        && (!('carrier' in request.resource.data.keys()) || request.resource.data.carrier is string)
        && (!('estimatedDelivery' in request.resource.data.keys()) || request.resource.data.estimatedDelivery is int)
        && (!('attachments' in request.resource.data.keys()) || (request.resource.data.attachments is list && request.resource.data.attachments.size() <= 50));
    }
    function customerOrderUpdate() {
      return isOrderOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes'])
        && (!('notes' in request.resource.data.keys()) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));
    }
    function userAllowedFields() {
      return request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'lastLoginAt', 'preferences']);
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid) && !exists(/databases/$(database)/documents/users/$(uid)) && userAllowedFields()
        && request.resource.data.uid == uid && request.resource.data.role == 'customer';
      allow update: if (isAdmin() && userAllowedFields() && request.resource.data.uid == uid && request.resource.data.createdAt == resource.data.createdAt)
        || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'lastLoginAt', 'preferences'])
        && request.resource.data.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if false;
    }

    // Per-user browsing history stores product IDs only; clients cannot write
    // arbitrary fields or another user's history.
    // Favorites are isolated by Firebase UID for both customer and admin accounts.
    match /users/{uid}/favorites/{productId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['productId', 'createdAt'])
        && request.resource.data.productId == productId
        && request.resource.data.createdAt == request.time;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/recentlyViewed/{productId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['productId', 'viewedAt'])
        && request.resource.data.productId == productId
        && request.resource.data.viewedAt == request.time;
      allow delete: if isOwner(uid);
    }

    match /products/{productId} {
      allow list, get: if resource.data.isActive == true || isAdmin();
      allow create: if isAdmin() && validProduct(request.resource.data);
      allow update: if isAdmin() && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && (!('id' in resource.data.keys()) || request.resource.data.id == resource.data.id);
      allow delete: if isAdmin();
    }


    match /carts/{uid} {
      function validCart(data) {
        return data.keys().hasOnly(['version', 'items', 'discount', 'lastUpdated'])
          && data.version == 1
          && data.items is list
          && data.items.size() <= 100
          && data.discount is map
          && data.discount.keys().hasOnly(['amount', 'currency'])
          && data.discount.amount is number
          && data.discount.amount >= 0
          && data.discount.currency in ['USD', 'MXN', 'EUR', 'GBP', 'CAD']
          && data.lastUpdated is string
          && data.lastUpdated.size() <= 64;
      }
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) && validCart(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || isOrderOwner();
      allow list: if isAdmin() || isOrderOwner();
      // All order creation, including admin-created orders, goes through the
      // server transaction that revalidates prices and adjusts stock.
      allow create: if false;
      allow update: if isAdmin() && adminOrderUpdate() || customerOrderUpdate();
      allow delete: if isAdmin();
    }

    match /productReviews/{reviewId} {
      // Public reads are safe because all writes are server-only and validated by /api/reviews.
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /reviewOwners/{ownerId} {
      // Private mapping from authenticated reviewer to public review document.
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && (
        (settingId == 'store'
          && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120)
        ||
        (settingId == 'reviewModeration'
          && request.resource.data.keys().hasOnly(['blockedTerms', 'maxLength', 'updatedAt'])
          && request.resource.data.blockedTerms is list
          && request.resource.data.blockedTerms.size() <= 200
          && request.resource.data.maxLength is int
          && request.resource.data.maxLength >= 10
          && request.resource.data.maxLength <= 1500
          && request.resource.data.updatedAt == request.time)
      );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
